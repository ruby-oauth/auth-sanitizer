module AuthSanitizer
  module Loader
    FILES: Array[String]

    def self.load_isolated: () -> Module
  end
end

module Auth
  module Sanitizer
    module Version
      VERSION: String
    end
    VERSION: String
    def self.default_filtered_keys: () -> Array[String]
    def self.filtered_label: () -> String
